# Managed by dotfiles/git. Pulled into ~/.ssh/config via an Include line that
# install.sh adds. One key reaches GitHub for every context; personal and work
# commits differ by email only, which gitconfig switches per directory.

# GitHub, personal and work alike. The account holds access to both
# domengabrovsek and the Pentla-tech org, so a second key buys nothing.
Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_personal
	IdentitiesOnly yes
	AddKeysToAgent yes
	UseKeychain yes

# ---------------------------------------------------------------------------
# Homelab hosts (pi5, pi4, air). Each has two aliases: `<host>` for the LAN IP
# and `<host>-remote` for the Tailscale IP, so the same alias works on and off
# the home network. All share one key (`id_rpi5`), which is NOT in this
# repo - copy the private key over or add a new pubkey to each host's
# authorized_keys. See git/README.md.
#
# id_rpi5 is this machine's key for reaching the hosts. It is unrelated to the
# id_github_<hostname> keys the hosts use to reach GitHub, which never leave the
# host they were generated on. The name predates air joining the homelab, so it
# reads pi5-specific while covering all three; the machine it identifies is in
# the pubkey comment, not the filename.
Host pi5
	HostName 192.168.0.2
	User pi
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host pi5-remote
	HostName 100.108.45.53
	User pi
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host pi4
	HostName 192.168.0.3
	User domengabrovsek
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host pi4-remote
	HostName 100.108.62.122
	User domengabrovsek
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

# air (M1 MacBook Air, Ubuntu Asahi). Wired static 192.168.0.7 via USB-C ethernet
# (primary); Wi-Fi 192.168.0.108 is the fallback. air-remote (Tailscale) works
# regardless of the LAN path.
Host air
	HostName 192.168.0.7
	User pi
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host air-remote
	HostName 100.117.139.53
	User pi
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes
