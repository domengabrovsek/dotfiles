# Managed by dotfiles/git. Pulled into ~/.ssh/config via an Include line that
# install.sh adds. Two aliases point at the same host (github.com) with
# different keys, which is how one machine commits as two GitHub identities.

# Personal GitHub (default host).
Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_personal
	IdentitiesOnly yes
	AddKeysToAgent yes
	UseKeychain yes

# Pentla (work) GitHub. Same host, different key. The url rewrite in gitconfig
# maps the Pentla-tech org onto this alias automatically.
Host github-pentla
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_pentla
	IdentitiesOnly yes
	AddKeysToAgent yes
	UseKeychain yes

# ---------------------------------------------------------------------------
# Homelab Raspberry Pis. Each Pi has two aliases: `<pi>` for the LAN IP and
# `<pi>-remote` for the Tailscale IP, so the same alias works on and off the
# home network. All share one key (`id_rpi5`), which is NOT in this
# repo - copy the private key over or add a new pubkey to each Pi's
# authorized_keys. See git/README.md.
Host pi5
	HostName 192.168.0.2
	User pi
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host pi5-remote
	HostName 100.108.45.53
	User pi
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host pi4
	HostName 192.168.0.3
	User domengabrovsek
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes

Host pi4-remote
	HostName 100.108.62.122
	User domengabrovsek
	IdentityFile ~/.ssh/id_rpi5
	IdentitiesOnly yes
