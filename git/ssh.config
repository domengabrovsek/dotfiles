# Managed by dotfiles/git. Pulled into ~/.ssh/config via an Include line that
# install.sh adds. Two aliases point at the same host (github.com) with
# different keys, which is how one machine commits as two GitHub identities.

# Personal GitHub (default host).
Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_personal
	IdentitiesOnly yes
	AddKeysToAgent yes
	UseKeychain yes

# Pentla (work) GitHub. Same host, different key. The url rewrite in gitconfig
# maps the Pentla-tech org onto this alias automatically.
Host github-pentla
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_pentla
	IdentitiesOnly yes
	AddKeysToAgent yes
	UseKeychain yes
