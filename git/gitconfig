# Managed by dotfiles/git. Symlinked to ~/.gitconfig.
# Personal is the default identity; work contexts override per-directory below.

[user]
	name = Domen Gabrovsek
	email = domen@domengabrovsek.com

[core]
	editor = code --wait

# Pentla (work): identity switches to the work email inside this folder.
# Trailing slash matters - it means "this dir and everything under it".
[includeIf "gitdir:~/dev/work/pentla/"]
	path = ~/.gitconfig-pentla
